{
  "name": "176-tcg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "176 TCG · ¡Hazte con los 176! Juego de cartas coleccionables sobre las elecciones generales del 29N de 2026.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:servidor": "tsx watch servidor/index.ts",
    "build": "npm run build:web",
    "build:web": "node scripts/preparar-ilustraciones.mjs --si-hay && tsc --noEmit && vite build --mode web",
    "build:archivo": "node scripts/preparar-ilustraciones.mjs --si-hay && tsc --noEmit && vite build",
    "build:servidor": "npm run build:web && node scripts/construir-servidor.mjs",
    "start": "node dist-servidor/servidor.mjs",
    "preview": "vite preview --mode web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simular": "tsx scripts/simular.ts",
    "cartas": "tsx scripts/listar-cartas.ts",
    "prompts": "tsx scripts/prompts-imagenes.ts",
    "ilustraciones": "node scripts/preparar-ilustraciones.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
}
